---
import ExperienceItem from "./ExperienceItem.astro"

const EXPERIENCE = [
      {
            date:"December 2024 - July 2025",
            title:"Java Software Engineer",
            place:"Akkodis",
            description:`- Currently leading the migration of database infrastructure from MySQL to BigQuery, focusing on optimizing data workflows and scalability. I design and implement automated pipelines to migrate tables through Jenkins, ensuring efficiency, reliability, and seamless integration with existing systems.`
      },
      {
            date:"December 2024 - July 2025",
            title:"Full-Stack Developer",
            place:"The Next Flow",
            description:`- Led the migration of Angular applications across multiple versions to ensure long-term maintainability and compatibility. 

- Contributed to both frontend and backend development in a project focused on the synchronization of passenger information for travel agencies.`
      },
      {
            date:"October 2022 - November 2024",
            title:"Full-Stack Web Developer",
            place:"Rodas Computación",
            description:`- Developed a digital parking meter platform as part of a mobility solution for Veracruz. Additionally, created a state platform for regulatory improvement for the state of Veracruz, which consisted of three web portals:

1. Procedures and Services Portal,
2. Procedures Registration Portal,
3. Citizen Portal.`,
      },
]
---
<ol class="relative border-s border-gray-200 dark:border-gray-700">                  
      
      {
            EXPERIENCE.map(experience=>(
                  <li class="mb-10 ms-4">
                        <ExperienceItem {...experience}/>
                  </li>
            ))
      }
      
  </ol>
  
  