---
import ExperienceItem from "./ExperienceItem.astro"

const EXPERIENCE = [
      {
            date:"2024 - Present",
            title:"Full-Stack Developer",
            place:"Solvo Global",
            description:`I am currently collaborating on the development of the Iberojet platform, a leading airline in Spain. My primary role focuses on backend development, leveraging Java and Spring Boot to create robust and scalable solutions that support the airline's critical operations.

1. Implementation of microservices to optimize reservation management and internal processes.
2. Configuration and integration of CI/CD pipelines in Bitbucket, automating deployments and improving the development cycle's efficiency.
3. Ensuring code quality through detailed reviews and automated testing.`
      },
      {
            date:"2022 - 2024",
            title:"Full-Stack Web Developer",
            place:"Rodas Computación",
            description:`Developed a digital parking meter platform as part of a mobility solution for Veracruz. Additionally, created a state platform for regulatory improvement for the state of Veracruz, which consisted of three web portals:

1. Procedures and Services Portal,
2. Procedures Registration Portal,
3. Citizen Portal.`,
            // link:"https://www.mejoraregulatoriamexico.com.mx/#/"
      },
      {
            date:"2021 - 2022",
            title:"Android Developer",
            place:"Gecosoft",
            description:`Developed a mobile application designed for comprehensive monitoring of chronic-degenerative diseases. 
The application focused on enhancing the management of medical treatments and the continuous tracking of users' vital signs and physical activity through wearable devices.`,
            // link:"https://premytecd.com/"
      }
]
---
<ol class="relative border-s border-gray-200 dark:border-gray-700">                  
      
      {
            EXPERIENCE.map(experience=>(
                  <li class="mb-10 ms-4">
                        <ExperienceItem {...experience}/>
                  </li>
            ))
      }
      
  </ol>
  
  